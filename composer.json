{
    "name": "opencck/mercurius-peer",
    "description": "Agent-to-agent (A2A v1.0) client for AMPHP: ECDSA P-256 identities, signed HTTP requests and a WebSocket with a key handshake, files sent ahead of a message",
    "type": "library",
    "license": "MIT",
    "keywords": ["amphp", "a2a", "agent", "ecdsa", "websocket", "json-rpc"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "amphp/amp": "^3",
        "amphp/http-client": "^5"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.22.2",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "Mercurius\\Peer\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mercurius\\Peer\\Test\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-progress --show-info=false",
        "check": [
            "@test",
            "@phpstan",
            "@psalm"
        ]
    }
}
